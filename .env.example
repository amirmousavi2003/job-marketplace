# Copy to .env and change values. NEVER commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=jobmarket
POSTGRES_USER=jobmarket
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# AI matching: local_ngram (default, offline, no key), openai_compatible or none

# Frontend base URL used in password-reset links
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT_SECONDS=3600
DEFAULT_FROM_EMAIL=no-reply@jobmarket.local
AI_EMBEDDING_PROVIDER=local_ngram
# Only for AI_EMBEDDING_PROVIDER=openai_compatible (any service with an OpenAI-style /embeddings API):
AI_EMBEDDING_API_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# ---- Production only ---------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_ALLOWED_HOSTS=api.example.ir
# CSRF_TRUSTED_ORIGINS=https://api.example.ir
# DJANGO_NUM_PROXIES=1                 # number of reverse proxies in front (nginx = 1)
# DJANGO_ADMIN_URL=manage-change-me/   # move the Django admin away from /admin/
# DJANGO_ENABLE_API_DOCS=False         # Swagger stays off in production
# REDIS_URL is REQUIRED in production (shared rate limiting)
# SMTP for password-reset emails:
# EMAIL_HOST=smtp.example.ir
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
