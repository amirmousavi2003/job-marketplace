# Copy to .env and change values. NEVER commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=jobmarket
POSTGRES_USER=jobmarket
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# AI matching (Phase 7). Leave empty to use the structured-only fallback.
EMBEDDING_PROVIDER=none
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Frontend base URL used in password-reset links
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT_SECONDS=3600
DEFAULT_FROM_EMAIL=no-reply@jobmarket.local
